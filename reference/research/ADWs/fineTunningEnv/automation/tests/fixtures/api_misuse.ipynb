      "source": [
        "import torch\n",
        "import torch.nn as nn\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "code-train",
      "metadata": {},
      "outputs": [],
      "source": [
        "model = nn.Linear(10, 2)\n",
        "optimizer = torch.optim.SGD(model.parameters(), lr=0.01)\n",
        "x = torch.randn(8, 10)\n",
        "loss = model(x).sum()\n",
        "loss.backward()\n",
        "optimizer.step()\n"
      ]
    }
  ],
